# =============================================================================
# fast-store — environment configuration
#
# Copy this file to `.env` in the repo root and fill in real values:
#   cp .env.example .env
#
# docker-compose.yaml reads this file automatically. Do NOT commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# JWT signing secret — shared between user-service (issues tokens) and
# order-service (verifies them, to know who's placing an order). Must be a
# long random string. The value below is a real random 64-char hex string
# generated for this file — fine to use as-is for local dev, but generate
# your own for anything beyond that:
#   openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=ff018ed2f3322a7f24692c5fcc65b9dffa72b700be2043413ef4ecdc70fc830d


GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin


# Where CPU/memory alert emails go (observability/grafana/provisioning/alerting/).
# Delivery needs GF_SMTP_ENABLED=true plus real SMTP credentials below --
# alerts still fire and show in the Grafana UI without them, they just won't
# email out.

ALERT_EMAIL_TO=shimdi247@gmail.com
GF_SMTP_ENABLED=true
GF_SMTP_HOST=smtp.gmail.com:587
GF_SMTP_USER=chimdi247@gmail.com
GF_SMTP_PASSWORD=
